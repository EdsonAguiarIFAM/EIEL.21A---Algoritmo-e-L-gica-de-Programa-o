17. Inserir no início
struct No{ int valor; No* proximo; };
void inserirInicio(No*& inicio, int valor){
    No* novo = new No();
    novo->valor = valor;
    novo->proximo = inicio;
    inicio = novo;
}
18. Percorrer lista
void listar(No* inicio){
    No* atual = inicio;
    while(atual!= nullptr){
        cout<<atual->valor<<" -> ";
        atual = atual->proximo;
    }
    cout<<"NULL";
}
19. Busca em lista
bool buscar(No* inicio, int valor){
    No* atual = inicio;
    while(atual!= nullptr){
        if(atual->valor == valor) return true;
        atual = atual->proximo;
    }
    return false;
}
